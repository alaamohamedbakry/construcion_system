<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="seq_construction_bid_file" model="ir.sequence">
        <field name="name">Bid File</field>
        <field name="code">construction.bid.file</field>
        <field name="prefix">BID/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>
    <record id="seq_construction_boq" model="ir.sequence">
        <field name="name">Construction BOQ</field>
        <field name="code">construction.boq</field>
        <field name="prefix">BOQ/</field>
        <field name="padding">4</field>
    </record>
    <record id="seq_construction_contract" model="ir.sequence">
        <field name="name">Contracts</field>
        <field name="code">construction.contract</field>
        <field name="prefix">CONT/</field>
        <field name="padding">5</field>
        <field name="number_increment">1</field>
    </record>
    <record id="seq_material_request" model="ir.sequence">
        <field name="name">Material Request</field>
        <field name="code">construction.material.request</field>
        <field name="prefix">MR/</field>
        <field name="padding">5</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>
    <record id="seq_construction_cost_center" model="ir.sequence">
        <field name="name">Construction Cost Center</field>
        <field name="code">construction.cost.center</field>
        <field name="prefix">CC/</field>
        <field name="padding">4</field>
    </record>

    <record id="seq_construction_estimation" model="ir.sequence">
    <field name="name">Construction Estimation</field>
    <field name="code">construction.estimation</field>
    <field name="prefix">EST/</field>
    <field name="padding">3</field>
    </record>

     <record id="seq_construction_progress_billing" model="ir.sequence">
    <field name="name">Construction Progress Billing</field>
    <field name="code">construction.progress.billing</field>
    <field name="prefix">BILL//</field>
    <field name="padding">5</field>
    </record>


     <record id="seq_construction_subcontract" model="ir.sequence">
    <field name="name">Construction SubContract</field>
    <field name="code">construction.subcontract</field>
    <field name="prefix">SUBCONT//</field>
    <field name="padding">4</field>
    </record>




</odoo>