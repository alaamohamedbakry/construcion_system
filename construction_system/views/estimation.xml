<?xml version="1.0" encoding="utf-8"?>
<odoo>




    <record id="construction_estimation_form" model="ir.ui.view">

        <field name="name">construction.estimation.form</field>

        <field name="model">construction.estimation</field>


        <field name="arch" type="xml">

            <form string="Cost Estimation">

                <sheet>



                    <div class="oe_title">

                        <label for="name"/>

                        <h1>
                            <field name="name"
                                   placeholder="EST/2026/001"/>
                        </h1>

                    </div>




                    <group>


                        <group string="Estimation Information">


                            <field name="boq_id"
                                   options="{'no_create': True, 'no_edit': True}"/>


                            <field name="project_id"
                                   readonly="1"/>


                        </group>



                        <group string="Cost Summary">


                            <field name="total_estimation_cost"
                                   readonly="1"/>


                        </group>


                    </group>



                    <separator string="Estimation Details"/>



                    <notebook>



                        <page string="Estimation Lines"
                              name="estimation_lines">


                            <field name="estimation_line_ids">


                                <tree editable="bottom">


                                    <field name="boq_line_id"
                                           readonly="1"/>


                                    <field name="quantity"
                                           readonly="1"/>


                                    <field name="material_cost"/>


                                    <field name="labor_cost"/>


                                    <field name="equipment_cost"/>


                                    <field name="subcontractor_cost"/>


                                    <field name="total_unit_cost"
                                           readonly="1"/>


                                    <field name="total_cost"
                                           readonly="1"
                                           sum="Total Cost"/>


                                </tree>


                            </field>


                        </page>




                        <page string="Information"
                              name="information">


                            <group>


                                <field name="create_uid"
                                       readonly="1"/>


                                <field name="create_date"
                                       readonly="1"/>


                            </group>


                        </page>



                    </notebook>



                </sheet>
                  

                   <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>

            </form>


        </field>


    </record>







    <record id="construction_estimation_tree" model="ir.ui.view">


        <field name="name">construction.estimation.tree</field>


        <field name="model">construction.estimation</field>



        <field name="arch" type="xml">


            <tree string="Cost Estimations">


                <field name="name"/>


                <field name="boq_id"/>


                <field name="project_id"/>


                <field name="total_estimation_cost"/>


            </tree>



        </field>


    </record>



</odoo>