<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_material_consumption_report_form"
            model="ir.ui.view">
        <field name="name">material.consumption.report.form</field>
        <field name="model">material.consumption.report</field>
        <field name="arch" type="xml">
            <form string="Material Consumption Report" create="false">
            <header>
             <button
            name="action_export_excel"
            type="object"
            string="Export Excel"
            class="btn-primary"/>
            </header>
                <sheet >
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_export_excel"
                        type="object"
                        string="Export Excel"
                        class="btn-primary"/>
                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_material_consumption_report" model="ir.actions.act_window">
        <field name="name">Material Consumption Report</field>
        <field name="res_model">material.consumption.report</field>
        <field name="view_id" ref="view_material_consumption_report_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>