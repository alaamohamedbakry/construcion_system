<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="contract_view_tree" model="ir.ui.view">
        <field name="name">construction.contract.tree.view</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <tree string="Contracts">
                <field name="name"/>
                <field name="customer_id"/>
                <field name="project_id"/>
                <field name="start_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <!-- Form View -->
    <record id="view_construction_contract_form" model="ir.ui.view">
        <field name="name">construction.contract.form.view</field>
        <field name="model">construction.contract</field>
        <field name="arch" type="xml">
            <form string="Construction Contract">
                <header>
                    <button name="action_approve" string="Approve" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_activate"  string="Activate"  type="object" class="oe_highlight" invisible="state != 'approved'"/>
                    <button name="action_complete" string="Close" type="object" class="oe_highlight" invisible="state != 'active'"/>
                    <button name="action_cancel"  string="Cancel"  type="object" class="btn-secondary" invisible="state in ['completed','cancel']"/>
                    <button name="action_create_project" string="Create Project" type="object" class="btn-primary" invisible="state != 'active' or project_id"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,approved,active,completed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_project"  type="object" class="oe_stat_button" icon="fa-folder-open"  invisible="project_count == 0">
                            <field name="project_count" widget="statinfo" string="Project"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="Contract Name ..."/>
                        </h1>
                    </div>
                    <!-- Smart Buttons -->
                    <div class="oe_button_box" name="button_box">
                       
                    </div>
                    <group>
                        <group string="General Information">
                            <field name="customer_id"/>
                            <field name="project_id" readonly="1"/>
                            <field name="tender_id"/>
                        </group>
                        <group string="Contract Information">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="currency_id"/>
                            <field name="contract_value"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Notes">
                            <field name="notes"
                                   nolabel="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>