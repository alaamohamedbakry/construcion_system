<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_budget_vs_actual_report_form"
            model="ir.ui.view">
        <field name="name">budget.vs.actual.report.form</field>
        <field name="model">budget.vs.actual.report</field>
        <field name="arch" type="xml">
            <form string="Budget vs Actual Cost Report" create="false">
            <header>
             <button
            name="action_export_excel"
            type="object"
            string="Export Excel"
            class="btn-primary"/>
            </header>
                <sheet >
                    <group>
                        <field name="name" readonly="1"/>
                    </group>
                </sheet>
                <footer>
                    <button
                        name="action_export_excel"
                        type="object"
                        string="Export Excel"
                        class="btn-primary"/>
                    <button
                        string="Cancel"
                        special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
    <record id="action_budget_vs_actual_report" model="ir.actions.act_window">
        <field name="name">Budget vs Actual Cost Report</field>
        <field name="res_model">budget.vs.actual.report</field>
        <field name="view_id" ref="view_budget_vs_actual_report_form"/>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>
</odoo>