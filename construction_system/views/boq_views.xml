<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <record id="view_construction_boq_form" model="ir.ui.view">
        <field name="name">construction.boq.form</field>
        <field name="model">construction.boq</field>
        <field name="arch" type="xml">

            <form string="BOQ">

                <header>

                     <div class="oe_button_box" name="button_box">

                            <button name="action_view_estimations"
                                    type="object"
                                    class="oe_stat_button"
                                    icon="fa-calculator">

                                <field name="estimation_count"
                                    widget="statinfo"
                                    string="Estimations"/>

                            </button>

                    </div>

                    
                    <button name="action_create_estimation"
                            string="Create Estimation"
                            type="object"
                            class="btn-primary"/>


                    <button name="action_review"
                            string="Send Review"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-success"
                            invisible="state != 'review'"/>


                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,review,approved"/>

                </header>


                <sheet>

                    <div class="oe_button_box" name="button_box">
                    </div>


                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>


                    <group>

                        <group string="Project Information">

                            <field name="project_id"
                                   options="{'no_create': True}"/>

                            <field name="tender_id"
                                   options="{'no_create': True}"/>

                            <field name="revision"/>

                        </group>


                        <group string="BOQ Summary">

                            <field name="total_quantity"
                                   readonly="1"/>

                            <field name="total_cost"
                                   readonly="1"
                                   class="oe_highlight"/>

                        </group>

                    </group>


                    <notebook>


                        <page string="BOQ Lines">

                            <field name="boq_line_ids">

                                <tree editable="bottom">

                                    <field name="name"
                                           string="Description"/>

                                    <field name="product_id"
                                           string="Item"/>

                                    <field name="uom_id"
                                           string="UOM"/>

                                    <field name="quantity"/>

                                    <field name="unit_price"/>

                                    <field name="total_cost"
                                           readonly="1"
                                           sum="Total"/>

                                </tree>

                            </field>

                        </page>


                    </notebook>


                    

                </sheet>

                
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids"/>
                    </div>
            </form>

        </field>
    </record>






    <record id="view_construction_boq_tree" model="ir.ui.view">

        <field name="name">construction.boq.tree</field>

        <field name="model">construction.boq</field>

        <field name="arch" type="xml">

            <tree string="BOQs">

                <field name="name"/>

                <field name="project_id"/>

                <field name="tender_id"/>

                <field name="total_cost"/>

                <field name="state"/>

            </tree>

        </field>

    </record>


</odoo>