<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_construction_cost_center_tree" model="ir.ui.view">
        <field name="name">construction.cost.center.tree</field>
        <field name="model">construction.cost.center</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="planned_budget"/>
                <field name="actual_cost"/>
                <field name="remaining_budget"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="view_construction_cost_center_form" model="ir.ui.view">
        <field name="name">construction.cost.center.form</field>
        <field name="model">construction.cost.center</field>
        <field name="arch" type="xml">
            <form string="Cost Center">
                <header>
                    <button name="action_start_monitoring"
                        string="Start Monitoring"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'active'"/>
                    <button name="action_close"
                        string="Close"
                        type="object"
                        class="oe_highlight"
                        invisible="state != 'monitoring'"/>
                    <field name="state"
                       widget="statusbar"
                       statusbar_visible="active,monitoring,closed"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_analytic" type="object"  class="oe_stat_button"  icon="fa-line-chart"  invisible="not analytic_account_id">
                            <field name="analytic_account_id"  widget="statinfo"  string="Analytic"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project Information">
                            <field name="project_id"/>
                            <field name="task_id"/>
                        </group>
                        <group string="Budget">
                            <field name="planned_budget"/>
                            <field name="actual_cost" readonly="1"/>
                            <field name="remaining_budget" readonly="1"/>
                            <field name="budget_variance" readonly="1"/>
                            <field name="analytic_account_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>
</odoo>