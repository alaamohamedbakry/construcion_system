<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sub_contract_view_tree" model="ir.ui.view">
        <field name="name">construction.subcontract.view.tree</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="boq_id"/>
                <field name="project_id"/>
                <field name="contractor_id"/>
                <field name="contract_date"/>
                <field name="total_amount"/>
                <field name="state"/>
            </tree>
        </field>
    </record>
    <record id="construction_subcontract_view_form" model="ir.ui.view">
        <field name="name">construction.subcontract.view.form</field>
        <field name="model">construction.subcontract</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_start" type="object" string="Start Work" invisible="state != 'confirmed'"/>
                    <button  name="action_complete" type="object"  string="Complete" invisible="state != 'in_progress'"/>
                    <button name="action_cancel" type="object"  string="Cancel" invisible="state == 'cancelled'"/>
                    <button name="action_create_purchase_order" type="object" string="Create Purchase Order" class="btn-primary" invisible="state != 'confirmed'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirmed,in_progress,completed,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_purchase_order" type="object" class="oe_stat_button" icon="fa-shopping-cart">
                            <field name="purchase_order_count"  widget="statinfo" string="Purchase Order"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <field name="boq_id" readonly="1"/>
                        <field name="project_id"/>
                        <field name="contractor_id"/>
                        <field name="contract_date"/>
                    </group>
                    <notebook>
                        <page string="BOQ Lines">
                            <field name="line_ids">
                                <tree editable="bottom">
                                    <field name="boq_line_id"/>
                                    <field name="name"/>
                                    <field name="quantity"/>
                                    <field name="unit_price"/>
                                    <field name="amount"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                    <group class="oe_subtotal_footer">
                        <field name="total_amount"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>