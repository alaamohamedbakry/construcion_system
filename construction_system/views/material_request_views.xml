<?xml version="1.0" encoding="utf-8"?>
<odoo>

    

    <record id="view_material_request_tree" model="ir.ui.view">
        <field name="name">construction.material.request.tree</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="requested_by"/>
                <field name="request_date"/>
                <field name="state"/>
            </tree>
        </field>
    </record>

        

    <record id="view_material_request_search" model="ir.ui.view">
        <field name="name">construction.material.request.search</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">
            <search>

                <field name="name"/>
                <field name="project_id"/>
                <field name="task_id"/>
                <field name="requested_by"/>

                <separator/>

                <filter string="Draft"
                        name="draft"
                        domain="[('state','=','draft')]"/>

                <filter string="Submitted"
                        name="submitted"
                        domain="[('state','=','submitted')]"/>

                <filter string="Approved"
                        name="approved"
                        domain="[('state','=','approved')]"/>

                <filter string="Issued"
                        name="issued"
                        domain="[('state','=','issued')]"/>

                <filter string="Done"
                        name="done"
                        domain="[('state','=','done')]"/>

                <separator/>

                <group expand="0" string="Group By">

                        <filter string="Project"
                                name="group_project"
                                context="{'group_by':'project_id'}"/>

                        <filter string="Task"
                                name="group_task"
                                context="{'group_by':'task_id'}"/>

                        <filter string="State"
                                name="group_state"
                                context="{'group_by':'state'}"/>

                        <filter string="Requested By"
                                name="group_requested_by"
                                context="{'group_by':'requested_by'}"/>

                </group>

            </search>
        </field>
    </record>


    <record id="view_material_request_form" model="ir.ui.view">
        <field name="name">construction.material.request.form</field>
        <field name="model">construction.material.request</field>
        <field name="arch" type="xml">

            <form string="Material Request">

                <header>

                    <button name="action_submit"
                            string="Submit"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'draft'"/>

                    <button name="action_approve"
                            string="Approve"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'submitted'"/>

                    <button name="action_issue"
                            string="Issue Materials"
                            type="object"
                            class="btn-primary"
                            invisible="state != 'approved'"/>

                    <button name="action_done"
                            string="Done"
                            type="object"
                            class="btn-success"
                            invisible="state != 'issued'"/>

                    <button name="action_cancel"
                            string="Cancel"
                            type="object"
                            class="btn-secondary"
                            invisible="state == 'done'"/>

                    <button name="action_reset_to_draft"
                            string="Reset to Draft"
                            type="object"
                            invisible="state != 'cancel'"/>

                    <field name="state"
                           widget="statusbar"
                           statusbar_visible="draft,submitted,approved,issued,done"/>

                </header>

                <sheet>

                    <div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>

                    <div class="oe_button_box" name="button_box">

                        <button name="action_view_purchase_orders"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-shopping-cart">

                            <field name="purchase_order_count"
                                   widget="statinfo"
                                   string="Purchase Orders"/>

                        </button>

                        <button name="action_view_stock_pickings"
                                type="object"
                                class="oe_stat_button"
                                icon="fa-truck">

                            <field name="stock_picking_count"
                                   widget="statinfo"
                                   string="Stock Pickings"/>

                        </button>

                    </div>

                    <group>

                        <group string="Project Information">

                            <field name="project_id"/>

                            <field name="task_id"/>

                        </group>

                        <group string="Request Information">

                            <field name="requested_by" readonly="1"/>

                            <field name="request_date"/>

                        </group>

                    </group>

                    <notebook>

                        <page string="Material Lines">

                            <field name="line_ids">

                                <tree editable="bottom">

                                  <field name="product_id"/>

                                    <field name="description"/>

                                    <field name="available_qty"
                                           readonly="1"/>

                                    <field name="quantity"/>

                                    <field name="product_uom_id"
                                           readonly="1"/>

                                    <field name="unit_price"
                                           readonly="1"/>

                                    <field name="subtotal"
                                           readonly="1"/>

                                </tree>

                            </field>

                        </page>

                    </notebook>

                    <group>

                        <group/>

                            <group class="oe_subtotal_footer oe_right">

                                <field name="total_amount" readonly="1"/>

                            </group>

                    </group>

                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                </div>

            </form>

        </field>
    </record>

    

</odoo>